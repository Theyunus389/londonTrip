# Required for the one shared list (the project URL is public).
NEXT_PUBLIC_SUPABASE_URL=
# SERVER ONLY: never use NEXT_PUBLIC_ for either of these.
SUPABASE_SERVICE_ROLE_KEY=
SHARED_EDIT_PIN=
# Optional: existing public anon key for recovering an older signed-in private trip.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional server-only production geocoding key.
GEOAPIFY_API_KEY=
# Optional authorised map provider and its required attribution.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
