# Both are public project identifiers, never use a service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# No keys required for OpenStreetMap tiles or optional explicit Nominatim searches.

# Optional server-only key for production location search (manual entry needs no key).
GEOAPIFY_API_KEY=

# Optional HTTPS tile provider URL template and its required attribution (public).
# Leave blank to use OpenStreetMap. Redeploy after changing NEXT_PUBLIC_* variables.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
